* {
  box-sizing: border-box;
}

:root {
  --bg: #020817;
  --panel: rgba(15, 23, 42, 0.82);
  --panel-strong: #0f172a;
  --text: #e2e8f0;
  --muted: #94a3b8;
  --accent: #8b5cf6;
  --accent-2: #38bdf8;
  --highlight: #f59e0b;
  --border: rgba(148, 163, 184, 0.2);
}

body {
  margin: 0;
  min-height: 100vh;
  font-family: Inter, 'Segoe UI', sans-serif;
  background:
    radial-gradient(circle at top left, rgba(139, 92, 246, 0.24), transparent 20%),
    radial-gradient(circle at bottom right, rgba(56, 189, 248, 0.18), transparent 22%),
    var(--bg);
  color: var(--text);
}

button, input, textarea, select {
  font: inherit;
}

.app-shell {
  max-width: 1280px;
  margin: 0 auto;
  padding: 28px 20px 40px;
}

.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
  margin-bottom: 22px;
}

.eyebrow {
  margin: 0 0 6px;
  color: var(--highlight);
  font-size: 0.74rem;
  text-transform: uppercase;
  letter-spacing: 0.14em;
}

h1 {
  margin: 0;
  font-size: clamp(2rem, 3vw, 3rem);
}

.status-badge {
  background: rgba(56, 189, 248, 0.12);
  border: 1px solid rgba(56, 189, 248, 0.4);
  color: #bae6fd;
  border-radius: 999px;
  padding: 8px 12px;
  font-size: 0.85rem;
}

.layout {
  display: grid;
  grid-template-columns: 1.2fr 0.8fr;
  gap: 20px;
}

.panel {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 18px;
  padding: 20px;
  box-shadow: 0 20px 45px rgba(2, 6, 23, 0.28);
}

.panel-header {
  margin-bottom: 16px;
}

.panel-header h2 {
  margin: 0;
  font-size: 1.3rem;
}

.persona-row {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-bottom: 18px;
}

label {
  display: flex;
  flex-direction: column;
  gap: 8px;
  color: var(--muted);
  font-size: 0.9rem;
}

select, textarea {
  width: 100%;
  padding: 12px 14px;
  border-radius: 12px;
  border: 1px solid var(--border);
  background: rgba(15, 23, 42, 0.8);
  color: var(--text);
}

textarea {
  resize: vertical;
  min-height: 90px;
}

.chat-messages {
  display: flex;
  flex-direction: column;
  gap: 12px;
  min-height: 420px;
  max-height: 520px;
  overflow-y: auto;
  padding-right: 6px;
}

.message {
  max-width: 82%;
  padding: 12px 14px;
  border-radius: 16px;
  line-height: 1.6;
  border: 1px solid var(--border);
}

.message.user {
  align-self: flex-end;
  background: rgba(139, 92, 246, 0.18);
}

.message.assistant {
  align-self: flex-start;
  background: rgba(56, 189, 248, 0.08);
}

.composer {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-top: 18px;
}

button {
  padding: 12px 18px;
  border: none;
  border-radius: 12px;
  background: linear-gradient(135deg, var(--accent), var(--accent-2));
  color: white;
  font-weight: 700;
  cursor: pointer;
  transition: transform 0.15s ease, filter 0.15s ease;
}

button:hover {
  transform: translateY(-1px);
  filter: brightness(1.08);
}

button:disabled {
  opacity: 0.7;
  cursor: wait;
}

.image-form {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.image-output {
  margin-top: 20px;
  border: 1px solid var(--border);
  background: rgba(2, 6, 23, 0.45);
  min-height: 320px;
  border-radius: 18px;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.image-output img {
  display: none;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.image-output img.visible {
  display: block;
}

@media (max-width: 900px) {
  .layout {
    grid-template-columns: 1fr;
  }

  .topbar {
    flex-direction: column;
    align-items: flex-start;
  }
}



